/target/
/.playwright-mcp/

# Downloaded/generated model payloads; keep models/models.json metadata.
/models/*.onnx
/models/*.pth
/models/interpolation/*.onnx
/.model-staging/

# Redistributable runtime payloads are staged for packaging, not source control.
/cuda/
/vendor/cuda/
/vendor/ffmpeg/bin/
/vendor/ffmpeg/doc/
/vendor/ffmpeg/include/
/vendor/ffmpeg/lib/
/vendor/ffmpeg/presets/

# Local run/build logs.
/out.txt
/err.txt
/rel-err.txt
*.pdb

# Easy-launch release copy and its beside-executable payloads. `ffmpeg/` is a
# copy of the vendored binaries placed next to the executable so the app
# resolves them relative to itself rather than through the compile-time source
# path, which is what makes the staged folder portable.
/Kraken Upscale*.exe
/ffmpeg/
/onnxruntime_providers_cuda.dll
/onnxruntime_providers_shared.dll

# Local run/build logs.
/stage-err.txt
