/target/
/.playwright-mcp/

# Downloaded/generated model payloads; keep models/**/models.json and READMEs.
/models/**/*.onnx
/models/**/*.onnx.data
/models/**/*.pth
/.model-staging/
/.native-staging/
/native-diffusion/
/rtx-vsr/
/models/generative/**/*.safetensors
/models/generative/**/*.sft
/models/generative/**/*.gguf
/models/generative/**/*.ckpt

# Local test clips — not source, and may contain copyrighted frames.
/assets/*.mp4
/assets/*.mkv

# Redistributable runtime payloads are staged for packaging, not source control.
/cuda/
/vendor/cuda/
/vendor/ffmpeg/bin/
/vendor/ffmpeg/doc/
/vendor/ffmpeg/include/
/vendor/ffmpeg/lib/
/vendor/ffmpeg/presets/

# Local run/build logs.
/out.txt
/err.txt
/rel-err.txt
*.pdb

# Easy-launch release copy and its beside-executable payloads. `ffmpeg/` is a
# copy of the vendored binaries placed next to the executable so the app
# resolves them relative to itself rather than through the compile-time source
# path, which is what makes the staged folder portable.
/Kraken Upscale*.exe
/ffmpeg/
/onnxruntime_providers_cuda.dll
/onnxruntime_providers_shared.dll
/onnxruntime_providers_nv_tensorrt_rtx.dll
/onnxruntime_providers_tensorrt.dll

# Local run/build logs.
/stage-err.txt

# Operator notes — keep on disk, do not publish.
/NEXT-SESSION.md
/DECISIONS.md
/ENHANCEMENTS.md
/bugslist.md
